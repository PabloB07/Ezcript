  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#73819F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword.other.todo.ezcript",
      "settings": {
        "foreground": "#F6BD60",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.ruby"
      ],
      "settings": {
        "foreground": "#C49BFF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.logical.ruby"
      ],
      "settings": {
        "foreground": "#FF83AF"
      }
    },
    {
      "scope": [
        "support.function.command.ezcript",
        "support.function.event.ezcript",
        "keyword.control.import.ezcript"
      ],
      "settings": {
        "foreground": "#6DE7FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.command.ezcript",
        "entity.name.function.event.ezcript"
      ],
      "settings": {
        "foreground": "#A9E878",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#F6BD60"
      }
    },
    {
      "scope": [
        "constant.other.symbol",
        "constant.other.symbol.ruby"
      ],
      "settings": {
        "foreground": "#6DE7FF"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.language.ruby"
      ],
      "settings": {
        "foreground": "#FF9A68",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.ruby"
      ],
      "settings": {
        "foreground": "#F6BD60"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.module",
        "entity.name.type.constant",
        "entity.name.type.java.ezcript",
        "constant.other.ruby"
      ],
      "settings": {
        "foreground": "#72C7FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.ruby"
      ],
      "settings": {
        "foreground": "#B995FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E2E9FA"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#FFAA72",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable.other.instance",
      "settings": {
        "foreground": "#FF83AF"
      }
    },
    {
      "scope": "entity.name.tag.ruby",
      "settings": {
        "foreground": "#6DE7FF"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#93A4C4"
      }
    },
    {
      "scope": "meta.embedded.line.ruby",
      "settings": {
        "foreground": "#F6BD60"
      }
    }
  ]
}
